+/// Desktop Wallet bridge: everything the wallet engine needs to plan one ordinary NOID payment, taken from this
+/// device's own verified view (direct to peers), in the same shape as a node's wallet context. Needs only the public
+/// address: the key stays in the wallet, which plans, checks and signs the payment itself.
+pub fn payment_context(args: &Value) -> Result<Value> {
+    let address = Address::parse(arg(args, "address")?)
+        .map_err(|e| anyhow::anyhow!("Invalid address: {e}"))?;
+    let (boundary, slots, proof_height) = view(args, address)?;
+    let epoch = noid_chain::consensus::tx_epoch_anchor_height_for_child(boundary.header.height + 1);
+    let anchor = boundary.anchor.context("Verified epoch header")?;
+    ensure!(anchor.height == epoch, "Payment epoch boundary");
+    let live = slots
+        .iter()
+        .filter(|(_, v)| **v != SlotValue::EMPTY && owner(**v) == address)
+        .map(|(index, v)| json!({"slot_index": index, "value": v.amount(), "creation_id": v.creation_id(), "owner": address.to_bech32(), "empty": false}))
+        .collect::<Vec<_>>();
+    ensure!(
+        live.len() <= 4096,
+        "This wallet has too many coins to spend at once; consolidate it first"
+    );
+    let empty = slots
+        .iter()
+        .filter(|(_, v)| **v == SlotValue::EMPTY)
+        .map(|(index, _)| *index)
+        .take(8)
+        .collect::<Vec<_>>();
+    ensure!(empty.len() >= 2, "Refresh State to obtain available output slots");
+    let fees = (1..=live.len().clamp(1, 64) as u64)
+        .map(|inputs| {
+            noid_chain::consensus::fees::fee_breakdown(
+                inputs,
+                2,
+                boundary.header.active_slot_count,
+                boundary.header.log_slots,
+            )
+            .required_total
+        })
+        .collect::<Vec<_>>();
+    Ok(json!({
+        "owner": address.to_bech32(),
+        "slots": live,
+        "empty": empty,
+        "anchor_hex": hex::encode(noid_chain::block_header::block_id(&anchor)),
+        "fees": fees,
+        "height": boundary.header.height,
+        "tipHash": hex::encode(noid_chain::block_header::block_id(&boundary.header)),
+        "balance_height": proof_height,
+        "source": "this-device"
+    }))
+}
